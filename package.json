{
  "name": "opnsense_vouchers_root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dockerize": "docker build -t knom/opnsense_vouchers .",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "build": "npm-run-all --parallel build:frontend build:backend", 
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build", 
    "build:backend": "npm --prefix backend run build",
    "ncu": "npm-run-all --parallel ncu:backend ncu:frontend ncu:root",
    "ncu:backend": "ncu -u --packageFile backend/package.json",
    "ncu:frontend": "ncu -u --packageFile frontend/package.json",
    "ncu:root": "ncu -u --packageFile package.json"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "npm-check-updates": "^23.1.0"
  }
}